{
  "name": "@academix-admin/app-shell",
  "version": "0.1.0",
  "description": "A phone-app shell for React: one navigation stack per tab, a tab bar on phones and a sidebar on wide screens, keyboard-safe sizing, safe areas, and tap-again-to-go-home — from one component.",
  "keywords": [
    "react",
    "app-shell",
    "pwa",
    "tab-bar",
    "sidebar",
    "navigation",
    "mobile",
    "keyboard"
  ],
  "license": "MIT",
  "author": "Academix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academix-admin/academix-ui.git",
    "directory": "packages/app-shell"
  },
  "homepage": "https://github.com/academix-admin/academix-ui/tree/main/packages/app-shell#readme",
  "bugs": {
    "url": "https://github.com/academix-admin/academix-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@academix-admin/navigation-stack": ">=1.13.0",
    "@academix-admin/navigation-bar": ">=0.2.0",
    "@academix-admin/sidebar": ">=0.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "@academix-admin/navigation-stack": "*",
    "@academix-admin/navigation-bar": "*",
    "@academix-admin/sidebar": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}

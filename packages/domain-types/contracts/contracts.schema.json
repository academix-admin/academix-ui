{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademixContracts",
  "description": "SINGLE SOURCE for Academix RPC/Lambda wire contracts. Each key under `definitions` is a wire type (the key IS the generated type name — kept identical to academix-web's current `Backend*` interfaces so the generated types are drop-in). Author each shape from its function's RETURN builder. The root references the top-level ones so the generator emits every reachable type. Regenerate TS + Dart with `npm run gen`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "getUserBalanceResponse": { "$ref": "#/definitions/GetUserBalanceResponse" },
    "backendUserBalanceModel": { "$ref": "#/definitions/BackendUserBalanceModel" },
    "backendTransactionModel": { "$ref": "#/definitions/BackendTransactionModel" },
    "backendUserEngagementModel": { "$ref": "#/definitions/BackendUserEngagementModel" },
    "backendDailyPerformance": { "$ref": "#/definitions/BackendDailyPerformance" },
    "backendDailyStreaksModel": { "$ref": "#/definitions/BackendDailyStreaksModel" },
    "backendAchievementsModel": { "$ref": "#/definitions/BackendAchievementsModel" },
    "backendAchievementsData": { "$ref": "#/definitions/BackendAchievementsData" },
    "backendMissionModel": { "$ref": "#/definitions/BackendMissionModel" },
    "backendMissionData": { "$ref": "#/definitions/BackendMissionData" },
    "backendRewardClaimModel": { "$ref": "#/definitions/BackendRewardClaimModel" },
    "backendPaymentCompletionData": { "$ref": "#/definitions/BackendPaymentCompletionData" },
    "backendFriendsModel": { "$ref": "#/definitions/BackendFriendsModel" },
    "backendQuizHistory": { "$ref": "#/definitions/BackendQuizHistory" },
    "backendRolesActivationData": { "$ref": "#/definitions/BackendRolesActivationData" },
    "backendRedeemCodeModel": { "$ref": "#/definitions/BackendRedeemCodeModel" },
    "backendGiveBackModel": { "$ref": "#/definitions/BackendGiveBackModel" }
  },
  "definitions": {
    "GetUserBalanceResponse": {
      "type": "object", "additionalProperties": false,
      "description": "public.get_user_balance response envelope",
      "required": ["status", "user_balance_details"],
      "properties": {
        "status": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "user_balance_details": { "oneOf": [{ "$ref": "#/definitions/BackendUserBalanceModel" }, { "type": "null" }] }
      }
    },
    "BackendUserBalanceModel": {
      "type": "object", "additionalProperties": false,
      "description": "public.get_user_balance -> user_balance_details",
      "required": ["users_id", "users_balance_amount", "users_balance_updated_at"],
      "properties": {
        "users_id": { "type": "string" },
        "users_balance_amount": { "type": "number" },
        "users_balance_updated_at": { "type": "string" }
      }
    },

    "BackendTransactionModel": {
      "type": "object", "additionalProperties": false,
      "description": "fetch_user_transactions / fetch_user_transaction_by_id transaction row",
      "required": [
        "transaction_id", "sort_created_id", "transaction_fee", "transaction_type", "transaction_created_at",
        "transaction_sender_rate", "transaction_receiver_rate", "transaction_sender_amount", "transaction_sender_status",
        "transaction_receiver_amount", "transaction_receiver_status", "transaction_sender_reference"
      ],
      "properties": {
        "pools_id": { "type": ["string", "null"] },
        "transaction_id": { "type": "string" },
        "sort_created_id": { "type": "string" },
        "transaction_fee": { "type": "number" },
        "transaction_type": { "type": "string" },
        "transaction_created_at": { "type": "string" },
        "transaction_sender_rate": { "type": "number" },
        "transaction_receiver_rate": { "type": "number" },
        "transaction_sender_amount": { "type": "number" },
        "transaction_sender_status": { "type": "string" },
        "transaction_receiver_amount": { "type": "number" },
        "transaction_receiver_status": { "type": "string" },
        "transaction_sender_reference": { "type": "string" },
        "payment_profile_sender_details": { "oneOf": [{ "$ref": "#/definitions/BackendPaymentProfileDetails" }, { "type": "null" }] },
        "payment_profile_receiver_details": { "oneOf": [{ "$ref": "#/definitions/BackendPaymentProfileDetails" }, { "type": "null" }] }
      }
    },
    "BackendPaymentProfileDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["users_details", "payment_method_details", "payment_wallet_details"],
      "properties": {
        "users_details": { "$ref": "#/definitions/BackendUserDetails" },
        "payment_method_details": { "$ref": "#/definitions/BackendPaymentMethodDetails" },
        "payment_wallet_details": { "$ref": "#/definitions/BackendPaymentWalletDetails" }
      }
    },
    "BackendPaymentMethodDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["payment_method_id", "payment_method_identity", "payment_method_checker"],
      "properties": {
        "payment_method_id": { "type": "string" },
        "payment_method_identity": { "type": "string" },
        "payment_method_checker": { "type": "string" }
      }
    },
    "BackendPaymentWalletDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["payment_wallet_id", "payment_wallet_identity", "payment_wallet_currency"],
      "properties": {
        "payment_wallet_id": { "type": "string" },
        "payment_wallet_identity": { "type": "string" },
        "payment_wallet_currency": { "type": "string" }
      }
    },
    "BackendUserDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["users_names"],
      "properties": {
        "users_id": { "type": ["string", "null"] },
        "users_names": { "type": "string" },
        "payment_details": { "oneOf": [{ "$ref": "#/definitions/BackendPaymentDetails" }, { "type": "null" }] }
      }
    },
    "BackendPaymentDetails": {
      "type": "object", "additionalProperties": false,
      "description": "payment profile detail fields (all optional/nullable)",
      "properties": {
        "email": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "country": { "type": ["string", "null"] },
        "network": { "type": ["string", "null"] },
        "fullname": { "type": ["string", "null"] },
        "private_account": { "type": ["boolean", "null"] },
        "e_naira": { "type": ["boolean", "null"] },
        "direct_debit": { "type": ["boolean", "null"] },
        "opay": { "type": ["boolean", "null"] },
        "bank_name": { "type": ["string", "null"] },
        "account_number": { "type": ["string", "null"] }
      }
    },

    "BackendUserEngagementModel": {
      "type": "object", "additionalProperties": false,
      "description": "get_user_engagement -> user_engagement_details",
      "required": [
        "user_engagement_total_time", "user_engagement_total_questions", "user_engagement_progress_win_count",
        "user_engagement_progress_time", "user_engagement_progress_questions", "user_engagement_progress_quiz_count",
        "user_engagement_progress_points_details"
      ],
      "properties": {
        "user_engagement_total_time": { "type": "number" },
        "user_engagement_total_questions": { "type": "number" },
        "user_engagement_progress_win_count": { "type": "number" },
        "user_engagement_progress_time": { "type": "number" },
        "user_engagement_progress_questions": { "type": "number" },
        "user_engagement_progress_quiz_count": { "type": "number" },
        "user_engagement_progress_points_details": { "$ref": "#/definitions/BackendHomeEngagementProgress" }
      }
    },
    "BackendHomeEngagementProgress": {
      "type": "object", "additionalProperties": false,
      "required": [
        "current_points", "engagement_levels_id", "points_to_next_level", "current_progress_percent",
        "next_engagement_levels_id", "engagement_levels_identity", "next_engagement_levels_identity"
      ],
      "properties": {
        "current_points": { "type": "number" },
        "engagement_levels_id": { "type": "number" },
        "points_to_next_level": { "type": "number" },
        "current_progress_percent": { "type": "number" },
        "next_engagement_levels_id": { "type": "number" },
        "engagement_levels_identity": { "type": "string" },
        "next_engagement_levels_identity": { "type": "string" }
      }
    },

    "BackendDailyPerformance": {
      "type": "object", "additionalProperties": false,
      "description": "get_user_daily_performance -> daily_performance_details",
      "required": ["daily_performance_for_earning", "daily_performance_for_quiz"],
      "properties": {
        "daily_performance_for_earning": { "type": "number" },
        "daily_performance_for_quiz": { "type": "number" }
      }
    },

    "BackendDailyStreaksModel": {
      "type": "object", "additionalProperties": false,
      "description": "claim_user_streaks / get_user_streaks -> daily_streaks_details",
      "required": [
        "daily_streaks_max", "daily_streaks_date", "daily_streaks_count", "daily_streaks_status",
        "daily_streaks_awarded", "daily_streaks_reached", "daily_streaks_date_number"
      ],
      "properties": {
        "daily_streaks_max": { "type": "number" },
        "daily_streaks_date": { "type": "string" },
        "daily_streaks_count": { "type": "number" },
        "redeem_code_details": { "oneOf": [{ "$ref": "#/definitions/BackendRewardRedeemCodeModel" }, { "type": "null" }] },
        "daily_streaks_status": { "type": "string" },
        "daily_streaks_awarded": { "type": "number" },
        "daily_streaks_reached": { "type": "boolean" },
        "daily_streaks_created_at": { "type": ["string", "null"] },
        "daily_streaks_date_number": { "type": "number" }
      }
    },
    "BackendRewardRedeemCodeModel": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "redeem_code_id": { "type": ["string", "null"] },
        "redeem_code_value": { "type": ["string", "null"] },
        "redeem_code_expires": { "type": ["string", "null"] }
      }
    },

    "BackendAchievementsModel": {
      "type": "object", "additionalProperties": false,
      "description": "fetch_user_achievements / claim_user_achievements achievement row",
      "required": ["achievements_id", "achievements_type", "sort_created_id", "achievements_requirement", "achievements_title", "achievements_description"],
      "properties": {
        "achievements_id": { "type": "string" },
        "achievements_type": { "type": "string" },
        "reward_details": { "oneOf": [{ "$ref": "#/definitions/BackendRewardDetails" }, { "type": "null" }] },
        "sort_created_id": { "type": "number" },
        "achievements_requirement": {
          "type": "object", "additionalProperties": false,
          "required": ["count"], "properties": { "count": { "type": "number" } }
        },
        "achievements_title": { "type": "string" },
        "achievements_image": { "type": ["string", "null"] },
        "achievements_progress_details": { "oneOf": [{ "$ref": "#/definitions/BackendAchievementsProgressDetails" }, { "type": "null" }] },
        "achievements_description": { "type": "string" }
      }
    },
    "BackendRewardDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["reward_id", "reward_type", "reward_limit", "reward_value", "reward_instruction"],
      "properties": {
        "reward_id": { "type": "string" },
        "reward_type": { "type": "string" },
        "reward_limit": { "type": "number" },
        "reward_value": { "type": "number" },
        "reward_instruction": { "type": "string" }
      }
    },
    "BackendAchievementsProgressDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["achievements_progress_count", "achievements_progress_required", "achievements_progress_rewarded", "achievements_progress_completed"],
      "properties": {
        "achievements_progress_id": { "type": ["string", "null"] },
        "achievements_progress_count": { "type": "number" },
        "achievements_progress_required": { "type": "number" },
        "achievements_progress_rewarded": { "type": "boolean" },
        "achievements_progress_completed": { "type": "boolean" },
        "achievements_progress_created_at": { "type": ["string", "null"] },
        "achievements_progress_updated_at": { "type": ["string", "null"] },
        "redeem_code_details": { "oneOf": [{ "$ref": "#/definitions/BackendRewardRedeemCodeModel" }, { "type": "null" }] }
      }
    },
    "BackendRewardClaimModel": {
      "type": "object", "additionalProperties": false,
      "description": "claim_user_achievements / claim_user_mission reward_claim_details",
      "required": ["reward_claim_amount"],
      "properties": {
        "reward_claim_amount": { "type": "number" },
        "reward_claim_redeem_code": { "oneOf": [{ "$ref": "#/definitions/BackendRewardRedeemCodeModel" }, { "type": "null" }] }
      }
    },
    "BackendAchievementsData": {
      "type": "object", "additionalProperties": false,
      "description": "get_user_achievements_count",
      "required": ["achievements_count", "achievements_finished", "achievements_completed", "achievements_not_rewarded"],
      "properties": {
        "achievements_count": { "type": "number" },
        "achievements_finished": { "type": "number" },
        "achievements_completed": { "type": "number" },
        "achievements_not_rewarded": { "type": "number" }
      }
    },

    "BackendMissionModel": {
      "type": "object", "additionalProperties": false,
      "description": "fetch_user_missions / claim_user_mission mission row",
      "required": ["mission_id", "mission_type", "sort_created_id", "mission_requirement", "mission_title", "mission_description"],
      "properties": {
        "mission_id": { "type": "string" },
        "mission_type": { "type": "string" },
        "reward_details": { "oneOf": [{ "$ref": "#/definitions/BackendRewardDetails" }, { "type": "null" }] },
        "sort_created_id": { "type": "number" },
        "mission_requirement": {
          "type": "object", "additionalProperties": false,
          "required": ["count"], "properties": { "count": { "type": "number" } }
        },
        "mission_title": { "type": "string" },
        "mission_image": { "type": ["string", "null"] },
        "mission_progress_details": { "oneOf": [{ "$ref": "#/definitions/BackendMissionProgressDetails" }, { "type": "null" }] },
        "mission_description": { "type": "string" }
      }
    },
    "BackendMissionProgressDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_progress_count", "mission_progress_required", "mission_progress_rewarded", "mission_progress_completed"],
      "properties": {
        "mission_progress_id": { "type": ["string", "null"] },
        "mission_progress_count": { "type": "number" },
        "mission_progress_required": { "type": "number" },
        "mission_progress_rewarded": { "type": "boolean" },
        "mission_progress_completed": { "type": "boolean" },
        "mission_progress_created_at": { "type": ["string", "null"] },
        "mission_progress_updated_at": { "type": ["string", "null"] },
        "redeem_code_details": { "oneOf": [{ "$ref": "#/definitions/BackendRewardRedeemCodeModel" }, { "type": "null" }] }
      }
    },
    "BackendMissionData": {
      "type": "object", "additionalProperties": false,
      "description": "get_user_missions_count",
      "required": ["mission_count", "mission_finished", "mission_completed", "mission_not_rewarded"],
      "properties": {
        "mission_count": { "type": "number" },
        "mission_finished": { "type": "number" },
        "mission_completed": { "type": "number" },
        "mission_not_rewarded": { "type": "number" }
      }
    },

    "BackendPaymentCompletionData": {
      "type": "object", "additionalProperties": false,
      "description": "make_payment completion payload (top-up/withdraw instructions)",
      "properties": {
        "link": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] },
        "bank": { "type": ["string", "null"] },
        "account": { "type": ["string", "null"] },
        "amount": { "type": ["number", "null"] },
        "reference": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "expire": { "type": ["string", "null"] }
      }
    },

    "BackendFriendsModel": {
      "type": "object", "additionalProperties": false,
      "description": "fetch_friends row",
      "required": ["users_id", "users_names", "users_username", "sort_created_id", "users_created_at", "users_referred_status"],
      "properties": {
        "users_id": { "type": "string" },
        "users_names": { "type": "string" },
        "users_username": { "type": "string" },
        "users_image": { "type": ["string", "null"] },
        "sort_created_id": { "type": "string" },
        "users_created_at": { "type": "string" },
        "users_referred_status": { "type": "string" }
      }
    },

    "BackendQuizHistory": {
      "type": "object", "additionalProperties": false,
      "description": "fetch_user_quiz_history row",
      "required": ["pools_id", "pools_duration", "sort_created_id", "topics_identity", "pools_members_rank", "pools_members_points", "challenge_question_count", "pools_members_created_at", "pools_members_paid_amount", "pools_completed_question_tracker_time", "pools_completed_question_tracker_size"],
      "properties": {
        "pools_id": { "type": "string" },
        "pools_duration": { "type": "number" },
        "sort_created_id": { "type": "string" },
        "topics_identity": { "type": "string" },
        "topics_image": { "type": ["string", "null"] },
        "pools_members_rank": { "type": "number" },
        "pools_members_points": { "type": "number" },
        "challenge_question_count": { "type": "number" },
        "pools_members_created_at": { "type": "string" },
        "pools_members_paid_amount": { "type": "number" },
        "pools_completed_question_tracker_time": { "type": "number" },
        "pools_completed_question_tracker_size": { "type": "number" }
      }
    },

    "BackendRolesActivationData": {
      "type": "object", "additionalProperties": false,
      "description": "create_or_get_academix_profile / roles activation",
      "required": ["roles_activation_amount", "roles_activation_activated"],
      "properties": {
        "roles_activation_amount": { "type": "number" },
        "roles_activation_activated": { "type": "boolean" },
        "transaction_id": { "type": ["string", "null"] },
        "roles_activation_is_fresh": { "type": "boolean" }
      }
    },

    "BackendRedeemCodeModel": {
      "type": "object", "additionalProperties": false,
      "description": "get_users_redeem_code / get_code_data redeem code",
      "required": ["redeem_code_id", "redeem_code_amount", "redeem_code_value", "sort_created_id", "redeem_rule_top", "redeem_rule_mid", "redeem_rule_bot", "redeem_rule_rank1", "redeem_rule_rank2", "redeem_rule_rank3"],
      "properties": {
        "redeem_code_id": { "type": "string" },
        "redeem_code_amount": { "type": "number" },
        "redeem_code_value": { "type": "string" },
        "sort_created_id": { "type": "string" },
        "redeem_code_expires": { "type": ["string", "null"] },
        "redeem_rule_top": { "type": "boolean" },
        "redeem_rule_mid": { "type": "boolean" },
        "redeem_rule_bot": { "type": "boolean" },
        "redeem_rule_rank1": { "type": "boolean" },
        "redeem_rule_rank2": { "type": "boolean" },
        "redeem_rule_rank3": { "type": "boolean" }
      }
    },

    "BackendGiveBackModel": {
      "type": "object", "additionalProperties": false,
      "description": "get_give_back_code / claim_giveback_code",
      "required": ["giveback_detail"],
      "properties": {
        "giveback_detail": { "$ref": "#/definitions/BackendGiveBackDetail" },
        "giveback_collection_details": { "oneOf": [{ "$ref": "#/definitions/BackendGiveBackCollectionDetails" }, { "type": "null" }] }
      }
    },
    "BackendGiveBackDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["giveback_id", "giveback_code", "giveback_unit_amount", "giveback_total_usage", "giveback_total_amount", "remaining_slots", "claimed_count", "sort_created_id", "redeem_rule_top", "redeem_rule_mid", "redeem_rule_bot", "redeem_rule_rank1", "redeem_rule_rank2", "redeem_rule_rank3"],
      "properties": {
        "giveback_id": { "type": "string" },
        "giveback_code": { "type": "string" },
        "giveback_unit_amount": { "type": "number" },
        "giveback_total_usage": { "type": "number" },
        "giveback_total_amount": { "type": "number" },
        "giveback_identifier": { "type": ["string", "null"] },
        "remaining_slots": { "type": "number" },
        "claimed_count": { "type": "number" },
        "sort_created_id": { "type": "string" },
        "redeem_rule_top": { "type": "boolean" },
        "redeem_rule_mid": { "type": "boolean" },
        "redeem_rule_bot": { "type": "boolean" },
        "redeem_rule_rank1": { "type": "boolean" },
        "redeem_rule_rank2": { "type": "boolean" },
        "redeem_rule_rank3": { "type": "boolean" }
      }
    },
    "BackendGiveBackCollectionDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["has_claimed", "is_spent", "remaining_slots", "can_claim", "has_password"],
      "properties": {
        "has_claimed": { "type": "boolean" },
        "redeem_code_value": { "type": ["string", "null"] },
        "is_spent": { "type": "boolean" },
        "remaining_slots": { "type": "number" },
        "can_claim": { "type": "boolean" },
        "has_password": { "type": "boolean" }
      }
    }
  }
}

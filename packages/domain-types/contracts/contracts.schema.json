{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademixContracts",
  "description": "SINGLE SOURCE for Academix RPC/Lambda wire contracts. Every response + nested wire type is a key under `definitions` (the key IS the generated type name). The root just references them all so the generator emits every type. Author each shape from its function's RETURN builder; regenerate TS + Dart from here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "getUserBalanceResponse": { "$ref": "#/definitions/GetUserBalanceResponse" }
  },
  "definitions": {
    "GetUserBalanceResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "user_balance_details"],
      "properties": {
        "status": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "user_balance_details": { "oneOf": [ { "$ref": "#/definitions/UserBalanceWire" }, { "type": "null" } ] }
      }
    },
    "UserBalanceWire": {
      "type": "object", "additionalProperties": false,
      "description": "public.get_user_balance RETURN builder",
      "required": ["users_id", "users_balance_amount", "users_balance_updated_at"],
      "properties": {
        "users_id": { "type": "string" },
        "users_balance_amount": { "type": "number" },
        "users_balance_updated_at": { "type": "string" }
      }
    }
  }
}

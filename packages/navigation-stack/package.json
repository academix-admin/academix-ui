{
  "name": "@academix-admin/navigation-stack",
  "version": "0.20.1",
  "description": "A powerful client-side navigation stack for React: transitions, swipe-back, scroll restoration, lazy pages, nested/group navigation, dependency injection and a request/response bus.",
  "keywords": [
    "react",
    "navigation",
    "router",
    "stack-navigator",
    "swipe-back",
    "scroll-restoration",
    "transitions",
    "spa"
  ],
  "license": "MIT",
  "author": "Academix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academix-admin/academix-ui.git",
    "directory": "packages/navigation-stack"
  },
  "homepage": "https://github.com/academix-admin/academix-ui/tree/main/packages/navigation-stack#readme",
  "bugs": {
    "url": "https://github.com/academix-admin/academix-ui/issues"
  },
  "type": "module",
  "_sideEffects": "The entry INSTALLS the dev inspector on import (src/index.ts), so it is not side-effect free and must not claim to be: a bundler told otherwise may drop whatever it likes. Naming the entries keeps tree-shaking working for every other module.",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "files": [
    "dist",
    "README.md",
    "EXAMPLES.md",
    "LICENSE",
    "DEVTOOLS.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@academix-admin/overlay-route": "^0.1.0"
  }
}

{
  "name": "academix-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Academix open-source React libraries.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "release": "npm run build && changeset publish",
    "check:surface": "node scripts/check-surface.mjs --strict",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "verify": "npm run build && npm run typecheck && npm test && npm run check:surface && npm run size"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
